{
  "name": "elog-fe-e2e-tests",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:ui": "cypress run --spec \"e2e/us0*.cy.ts\" --env STEP_DELAY_MS=0",
    "cy:run:fullstack": "cypress run --spec \"e2e/fullstack/*.fullstack.cy.ts\" --env STEP_DELAY_MS=0",
    "cy:run:all": "npm run cy:run:ui && npm run cy:run:fullstack"
  },
  "devDependencies": {
    "cypress": "^15.17.0"
  }
}
